  "info": {
    "title": "ShopApi API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SignInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@example.com"
          },
          "password": {
            "type": "string",
            "example": "change-me"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SignInWithTokenDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "Kategoriya": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "deletedAt": {
            "type": "object",
            "nullable": true
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "object",
            "nullable": true
          },
          "sortOrder": {
            "type": "object",
            "nullable": true
          },
          "active": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "id",
          "createdAt",
          "updatedAt",
          "name",
          "active"
        ]
      },
      "QueryKategoriyaDto": {
        "type": "object",
        "properties": {
          "first": {
            "type": "number",
            "example": 0,
            "description": "Offset (first row index)"
          },
          "rows": {
            "type": "number",
            "example": 10,
            "description": "Rows per page (1..100)"
          },
          "sortField": {
            "type": "object",
            "example": "createdAt",
            "description": "Column to sort; empty = default sort"
          },
          "sortOrder": {
            "type": "object",
            "example": -1,
            "description": "1 = ASC, anything else = DESC"
          },
          "filters": {
            "type": "object",
            "additionalProperties": true,
            "example": {
              "name": {
                "value": "abc",
                "matchMode": "contains"
              }
            },
            "description": "PrimeNG filters: { field: { value, matchMode } } or { field: [{ value, matchMode, operator }] }. matchMode: startsWith, contains, notContains, endsWith, equals, notEquals, in, lt, lte, gt, gte, between, dateIs, dateIsNot, dateBefore, dateAfter. Joined relations: \"category.name\"."
          },
          "globalFilter": {
            "type": "object",
            "example": "search",
            "description": "Global search over the service searchFields"
          }
        }
      },
      "CreateKategoriyaDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "object",
            "nullable": true
          },
          "sortOrder": {
            "type": "object",
            "nullable": true
          },
          "active": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateKategoriyaDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "object",
            "nullable": true
          },
          "sortOrder": {
            "type": "object",
            "nullable": true
          },
          "active": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "DeleteResultDto": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "deleted",
          "id"
        ]
      },
      "Mahsulot": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "deletedAt": {
            "type": "object",
            "nullable": true
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "price": {
            "type": "number"
          },
          "active": {
            "type": "boolean",
