{
  "name": "fuse-schematics",
  "version": "2.0.0",
  "description": "Fuse Admin (Angular 20) loyihalarini va CRUD feature modullarini avtomatik generatsiya qiluvchi Angular schematics to'plami",
  "main": "src/collection.json",
  "schematics": "./src/collection.json",
  "ng-add": {
    "save": "devDependencies"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && jasmine src/**/*_spec.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "angular",
    "schematics",
    "fuse",
    "fuse-admin",
    "angular-schematics",
    "crud",
    "generator",
    "code-generator",
    "angular20",
    "primeng",
    "tailwind",
    "typescript",
    "enterprise",
    "admin-template",
    "dashboard",
    "crud-generator",
    "angular-crud",
    "scaffolding"
  ],
  "author": {
    "name": "Islom Karimov",
    "email": "islomkarimovalisherovich@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Islom1999/fuse-schematics.git"
  },
  "bugs": {
    "url": "https://github.com/Islom1999/fuse-schematics/issues"
  },
  "homepage": "https://github.com/Islom1999/fuse-schematics#readme",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.0.0"
  },
  "peerDependencies": {
    "@angular/core": "^20.0.0"
  },
  "dependencies": {
    "@angular-devkit/core": "^20.3.9",
    "@angular-devkit/schematics": "^20.3.9",
    "typescript": "~5.9.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "jasmine": "^5.0.0"
  },
  "files": [
    "src",
    "!src/**/*_spec.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
